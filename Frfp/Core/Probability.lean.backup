/-- Geometric survival: S(n) = (1-λ)^n for constant hazard λ -/
theorem geometric_survival (lambda : Float) (n : Nat) :
    S[constant_hazard_stopping_time lambda](n) = float_pow (1.0 - lambda) n := by
